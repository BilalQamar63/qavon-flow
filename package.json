{
  "name": "qavonflow",
  "private": true,
  "version": "1.0.0",
  "description": "QavonFlow by Qavon Digital — Client Onboarding & Asset Management Platform for collecting project requirements, organizing brand assets, and tracking client workflows in one workspace.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "clean:data": "rm -rf data",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:cloudinary": "tsx server/services/cloudinary/migration.service.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/genai": "^2.4.0",
    "@mui/material": "^9.5.0",
    "@reduxjs/toolkit": "^2.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-redux": "^9.3.1",
    "vite": "^8.3.0",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
